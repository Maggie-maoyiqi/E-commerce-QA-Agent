# DeepSeek LLM (required for full AI answers; without it runs in rule-based fallback mode)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Neo4j Graph Database (Step 4+)
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# GraphRAG (Step 2+)
GRAPHRAG_PROJECT_DIR=data/graphrag
GRAPHRAG_QUERY_TYPE=local

# Embeddings - BGE-M3 via Ollama (Step 3+)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
